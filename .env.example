# Configuración de Groq con Fallbacks
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
GROQ_API_KEY=tu_groq_api_key_aqui

# Exportar borradores a Google Drive como Google Doc nativo (botón "Guardar en Google Drive")
# Ver README.md, sección "Exportar a Google Drive", para los pasos de configuración.
GOOGLE_OAUTH_CLIENT_SECRET_FILE=google-oauth-client-secret.json
GOOGLE_OAUTH_TOKEN_FILE=google-oauth-token.json

# Un ID de carpeta de Drive por destino. Puedes usar la misma carpeta para
# varios, o dejar sin configurar los que no vayas a usar todavía (el botón
# de exportar mostrará un error claro si eliges uno sin configurar).
GOOGLE_DRIVE_FOLDER_BORRADORES=tu_id_de_carpeta_borradores
GOOGLE_DRIVE_FOLDER_NOTES_PUBLICADOS=tu_id_de_carpeta_notes_publicados
GOOGLE_DRIVE_FOLDER_POSTS_PUBLICADOS=tu_id_de_carpeta_posts_publicados

# RAG ligero: buscar piezas ya publicadas parecidas a una idea nueva.
# Ver README.md, sección "Catálogo publicado (RAG ligero)".
GEMINI_API_KEY=tu_clave_de_gemini_aqui
# Opcionales (tienen valores por defecto razonables):
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_EMBEDDING_DIMENSIONS=768
